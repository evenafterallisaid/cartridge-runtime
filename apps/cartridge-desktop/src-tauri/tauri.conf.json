{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartridge",
  "version": "0.1.0",
  "identifier": "dev.cartridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cartridge",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false
  }
}
